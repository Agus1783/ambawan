# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Server
HOST=localhost
PORT=3000

# JWT (isi dengan string acak yang panjang)
ACCESS_TOKEN_KEY=isi-dengan-string-acak
REFRESH_TOKEN_KEY=isi-dengan-string-acak

# Google OAuth (dipakai POST /auth/google untuk verifikasi id_token;
# hanya CLIENT_ID yang dipakai endpoint ini — SECRET/REDIRECT_URI
# untuk alur authorization code di frontend bila diperlukan nanti)
GOOGLE_CLIENT_ID=isi-dengan-client-id-dari-google-cloud-console
GOOGLE_CLIENT_SECRET=isi-dengan-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email undangan (langkah 9; dipakai src/utils/mailer.ts).
# Bila SMTP_HOST kosong, email tidak dikirim dan token undangan
# dicatat di log server seperti sebelumnya. SMTP_PORT default 587
# (465 = implicit TLS). SMTP_FROM default ke SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Basis tautan accept undangan di email (default http://localhost:3000).
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase Storage untuk lampiran task (langkah 10; dipakai
# src/utils/storage.ts). Bila ketiga variabel ini kosong, file
# disimpan lokal di `uploads/` dan disajikan di `/uploads`.
# SUPABASE_SERVICE_ROLE_KEY adalah service_role key (bukan anon
# key) — simpan hanya di server, jangan disebar ke frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Redis cache (langkah 11; dipakai src/utils/cache.ts).
# Bila REDIS_URL kosong, semua operasi cache menjadi no-op
# pass-through dan perilaku sekarang tidak berubah. Isi dengan
# URL Redis, mis. redis://localhost:6379 (atau URL dari
# penyedia Redis seperti Upstash/Redis Cloud).
REDIS_URL=
