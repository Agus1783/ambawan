# URL dasar API backend AmbaDo (tanpa trailing slash).
VITE_API_URL=http://localhost:3000/api/v1
# Client ID Google untuk tombol "Login dengan Google" (opsional).
# Isi dengan nilai yang sama seperti GOOGLE_CLIENT_ID di backend/.env.
# Bila dikosongkan, tombol Google menampilkan catatan belum dikonfigurasi.
VITE_GOOGLE_CLIENT_ID=
